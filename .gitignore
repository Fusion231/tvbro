# Private Android release-signing material. The tracked debug keystore is
# deliberately non-secret and must never be used by the release build type.
*.jks
*.keystore
**/key.properties
.signing/
*.p12
*.pfx
*.p8
*.key
*.pem
*.clixml

# Claude Code agent memory store (not project files)
/memory/

# Local cloud-sync config for `flutter run --dart-define-from-file=dart_define.json`.
# Holds only the publishable Supabase values; keep it out of git regardless.
/dart_define.json
/clients/player/dart_define.json

# Local all-platform release settings (including the Partner Center identity).
/scripts/release-config.json

# Local Flutter DevTools settings.
/clients/player/devtools_options.yaml

# Working drafts / notes not meant for the repo (store-listing copy, questionnaire
# answers, tester-feedback triage, etc.). Local scratch only.
/docs/private/

# Local agent configuration and generated planning notes are not project source.
/.claude/
/CLAUDE.md
/docs/superpowers/

# Local deployment credentials.
.env
.env.*
*.env
!.env.example
/clients/player/android/.kotlin/
