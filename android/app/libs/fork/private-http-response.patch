+        env->ReleaseStringUTFChars(jvalue, wire);
+        if (!valid) { die(env, "Invalid private HTTP headers"); return; }
+        if (!mpv_instance->mpv) { die(env, "mpv is not initialized"); return; }
+        // Build all strings first; their backing storage lives through the
