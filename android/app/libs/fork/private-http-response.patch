+            nodes[i].format = MPV_FORMAT_STRING;
+            nodes[i].u.string = const_cast<char*>(fields[i].c_str());
+        }
+        mpv_node_list list{};
+        list.num = static_cast<int>(nodes.size());
+        list.values = nodes.empty() ? nullptr : nodes.data();
+        mpv_node array{};
+        array.format = MPV_FORMAT_NODE_ARRAY;
+        array.u.list = &list;
+        if (mpv_set_property(mpv_instance->mpv, "http-header-fields", MPV_FORMAT_NODE, &array) < 0)
+            die(env, "Could not apply private HTTP headers");
+        return;
